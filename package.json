{
  "name": "postchars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run test && tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/enhance-html.mjs && node scripts/verify-seo.mjs && node scripts/audit-site.mjs && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/",
    "test:e2e": "playwright test",
    "test:check": "npm run build && npm run test:e2e",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twitter-text": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=22 <25"
  }
}